resource_group_name = "rg-migration-planning-prod"
location            = "eastus"

vnet_name                  = "vnet-migration-planning"
vnet_address_space         = ["10.20.0.0/16"]
app_subnet_name            = "snet-app-integration"
app_subnet_address_prefix  = "10.20.1.0/24"
pe_subnet_name             = "snet-private-endpoints"
pe_subnet_address_prefix   = "10.20.2.0/24"
mysql_subnet_name          = "snet-mysql"
mysql_subnet_address_prefix = "10.20.3.0/24"

app_service_plan_name    = "asp-migration-planning"
app_service_plan_sku     = "P1v3"
app_service_name         = "app-migration-planning"
app_service_always_on    = true
app_service_node_version = "20-lts"

mysql_server_name             = "mysql-migration-planning"
mysql_administrator_login     = "mysqladmin"
# Do NOT put the real password here - pass it via TF_VAR_mysql_administrator_password
# or a separate untracked *.auto.tfvars file instead.
# mysql_administrator_password = "set-me-securely"
mysql_sku_name                = "GP_Standard_D2ds_v4"
mysql_version                 = "8.0.21"
mysql_storage_size_gb         = 32
mysql_backup_retention_days   = 7
mysql_database_name           = "appdb"

tags = {
  application = "migration-planning"
  environment = "prod"
}
