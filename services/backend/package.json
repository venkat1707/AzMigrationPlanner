    "start": "node dist/index.js"
  },
  "dependencies": {
    "@azure/msal-node": "^5.4.3",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.10.1",
    "ipaddr.js": "^1.9.1",
    "jszip": "^3.10.1",
    "knex": "^3.1.0",
    "multer": "^2.2.0",
    "mysql2": "^3.15.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/multer": "^2.2.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2"
  }
