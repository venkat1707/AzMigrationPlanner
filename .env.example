MYSQL_HOST=your-mysql-host.example.com
MYSQL_DATABASE=your_database
MYSQL_PORT=3306
MYSQL_USER=your_database_user
MYSQL_PASSWORD=replace-with-a-secret-from-your-secret-store
MYSQL_SSL=true
PORT=3000

# Microsoft Entra application credential. Use a client secret locally, or enable
# workload identity federation with a user-assigned managed identity in Azure.
ENTRA_CLIENT_SECRET=
ENTRA_USE_MANAGED_IDENTITY=false
AZURE_CLIENT_ID=