<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="services/backend/dist/index.js" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="AllRequestsToNode">
          <match url="/*" />
          <action type="Rewrite" url="services/backend/dist/index.js" />
        </rule>
      </rules>
    </rewrite>
    <!-- Package filesystem is read-only under WEBSITE_RUN_FROM_PACKAGE, so disable iisnode logging. -->
    <iisnode loggingEnabled="false" nodeProcessCommandLine="node" />
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
