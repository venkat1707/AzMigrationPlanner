{
  "name": "dependency-explorer",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": ["services/frontend", "services/backend"],
  "scripts": {
    "build": "npm run build --workspace frontend && npm run build --workspace backend",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "lint": "npm run lint --workspace frontend && npm run lint --workspace backend",
    "test": "npm run test --workspace backend",
    "migrate": "npm run migrate --workspace backend",
    "import": "npm run import --workspace backend --",
    "generate:dataset": "node scripts/generate-synthetic-dataset.mjs",
    "convert:corelight": "node scripts/convert-corelight-flow-logs.mjs",
    "status:dependency-delete": "node scripts/check-dependency-delete-progress.mjs",
    "status:dependency-insert": "node scripts/check-dependency-insert-progress.mjs",
    "start": "npm run start --workspace backend",
    "audit:check": "node scripts/audit-check.mjs"
  },
  "devDependencies": { "archiver": "^7.0.1", "concurrently": "^9.2.1" }
}
